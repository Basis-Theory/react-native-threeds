PUBLIC_API_KEY=
API_BASE_URL=https://api.flock-dev.com
SCRIPT_SRC=https://3ds.basistheory.com
# true selects the Codegen TurboModule; false selects the WebView comparison.
USE_TURBO_3DS=true
# Merchant-owned endpoint. It receives a session ID and keeps the private key server-side.
# Use http://10.0.2.2:3333 on the Android emulator.
AUTHENTICATION_ENDPOINT=http://localhost:3333/3ds/authenticate
